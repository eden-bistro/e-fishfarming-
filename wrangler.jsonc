{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e-fishfarm",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "AI_PROVIDER": "groq",
    "AI_MODEL": "openai/gpt-oss-120b",
    "AI_VISION_MODEL": "qwen/qwen3.8-27b",
  },
}
