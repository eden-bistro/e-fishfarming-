# Runtime
NODE_ENV=production
# Supabase (server-style names)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SENSOR_READINGS_TABLE=water_readings
# Optional: set in Supabase dashboard (Auth -> JWT/session settings), not here:
# - short access token lifetime
# - refresh token rotation enabled


# Vite client-exposed names (used by current frontend code)
VITE_SUPABASE_URL=https://oalxkihmpqovopifxlbq.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_DEFAULT_FARM_ID=farmer_001
VITE_DEFAULT_POND_ID=cage_001
# Optional feature flag for strict production checks in health endpoint/readiness tooling
REQUIRE_DUAL_BACKEND=true

# Device/API auth
IOT_INGEST_TOKEN=
JWT_SECRET=

# AquaSmart AI (server-only; do not expose this with a VITE_ prefix)
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=

# Firebase RTDB base URL (server-side naming fallback)
FIREBASE_DATABASE_URL=

# Firebase server-side write auth for /api/iot/ingest
# Preferred: paste the full service account JSON as a single env value.
FIREBASE_SERVICE_ACCOUNT=
# Legacy fallback if service account JSON is not available:
FIREBASE_DATABASE_SECRET=
FIREBASE_AUTH_TOKEN=

# Firebase project metadata used by deployment automation/docs
FIREBASE_PROJECT_ID=

# Deployment checklist for this repo's current industrial architecture:
# 1) keep both Firebase + Supabase configured
# 2) do not use non-expiring tokens; use managed refresh/rotation
# 3) apply firebase/database.rules.json and run `supabase db push`

